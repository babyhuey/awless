#!/bin/sh
# Pre-commit hook: run gofmt and golangci-lint on staged Go files

set -e

# Check for gofmt issues on staged .go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    exit 0
fi

# Check formatting
UNFORMATTED=$(echo "$STAGED_GO_FILES" | xargs gofmt -l 2>/dev/null || true)
if [ -n "$UNFORMATTED" ]; then
    echo "ERROR: The following files are not properly formatted (gofmt):"
    echo "$UNFORMATTED"
    echo ""
    echo "Run 'gofmt -w' on them or use 'go fmt ./...' to fix."
    exit 1
fi

# Run golangci-lint if available
if command -v golangci-lint >/dev/null 2>&1; then
    echo "Running golangci-lint..."
    golangci-lint run ./...
fi

echo "Pre-commit checks passed."
